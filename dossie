        function alternarStatusCampanha() {
            if (document.body.classList.contains('modo-jogador')) return;
            const stamp = document.getElementById('stamp-status');
            const atual = stamp.getAttribute('data-status') || 'CONCLUÍDA';
            const idx = (STATUS_CICLO.indexOf(atual) + 1) % STATUS_CICLO.length;
            const novo = STATUS_CICLO[idx];
            stamp.setAttribute('data-status', novo);
            stamp.innerText = novo;
            agendarSalvamento();
        }

