        function alternarModoVisualizacao(modo) {
            const btnMestre = document.getElementById('btn-modo-mestre');
            const btnJogador = document.getElementById('btn-modo-jogador');
            const editaveis = document.querySelectorAll('.editable-field, .editable-block');

            if (modo === 'jogador') {
                document.body.classList.add('modo-jogador');
                btnMestre.classList.remove('active');
                btnJogador.classList.add('active');
                editaveis.forEach(el => el.setAttribute('contenteditable', 'false'));
            } else {
                document.body.classList.remove('modo-jogador');
                btnJogador.classList.remove('active');
                btnMestre.classList.add('active');
                editaveis.forEach(el => el.setAttribute('contenteditable', 'true'));
            }
