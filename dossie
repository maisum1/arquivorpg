<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A.R.Q.U.I.V.O. — Dossiê de Continuidade</title>

    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;600;700;800;900&family=Special+Elite&family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Libre+Barcode+39+Text&display=swap');

        :root {
            --bg-desk: #161514;
            --bg-paper: #dcd7cb;
            --bg-card: #ebe6dc;
            --op-ink: #1a1a1a;
            --op-red: #9e0b0f;
            --op-dark-red: #5a0000;
            --san-purple: #2b3a4a;
            --pe-orange: #665235;
            --cor-muted: #524c42;
            --border-ink: rgba(26, 26, 26, 0.28);
            --border-strong: #1a1a1a;
            --gm-bg: #efe5c8;
            --gm-border: #8c6d23;
            --gm-text: #4a380d;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 80px 20px 60px 20px;
            background-color: var(--bg-desk);
            background-image: radial-gradient(circle at center, #242220 0%, #0d0c0c 100%);
            color: var(--op-ink);
            font-family: 'Courier Prime', monospace;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* BARRA SUPERIOR DE CONTROLE (NÃO SAI NO PDF) */
        .top-toolbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            background: #111111;
            border-bottom: 2px solid var(--op-red);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            z-index: 9999;
            box-shadow: 0 4px 20px rgba(0,0,0,0.8);
            gap: 12px;
        }

        .toolbar-left, .toolbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-back-hub {
            background: transparent;
            color: #dcd7cb;
            border: 1px dashed #777;
            padding: 7px 14px;
            font-family: 'Special Elite', monospace;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 2px;
            transition: 0.2s;
        }

        .btn-back-hub:hover {
            border-color: var(--op-red);
            color: #fff;
            background: rgba(158, 11, 15, 0.15);
        }

        .sync-badge {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 700;
            color: #aaa;
            letter-spacing: 0.5px;
            padding: 4px 10px;
            border: 1px dotted #444;
            border-radius: 2px;
        }

        .toolbar-btn {
            background: #222;
            color: #dcd7cb;
            border: 1px solid #444;
            padding: 8px 14px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            cursor: pointer;
            border-radius: 2px;
            transition: 0.2s;
        }

        .toolbar-btn:hover {
            background: #333;
            border-color: #888;
        }

        .toolbar-btn.active {
            background: var(--san-purple);
            color: #fff;
            border-color: #5aa8cc;
        }

        .toolbar-btn.btn-export {
            background: var(--op-red);
            color: #fff;
            border-color: #ff4d4d;
            box-shadow: 2px 2px 0px #000;
        }

        .toolbar-btn.btn-export:hover {
            background: #b80d12;
        }

        .toolbar-btn.btn-import-hub {
            border-color: #a68a64;
            color: #e0c8a0;
        }

        /* FOLHA DE ARQUIVO / DOSSIÊ */
        .dossier-sheet {
            width: 100%;
            max-width: 900px;
            background-color: var(--bg-paper);
            background-image:
                radial-gradient(circle at 12% 18%, rgba(139, 115, 85, 0.08) 0%, transparent 25%),
                radial-gradient(circle at 85% 15%, rgba(100, 80, 60, 0.07) 0%, transparent 30%),
                radial-gradient(circle at 88% 82%, rgba(120, 100, 80, 0.08) 0%, transparent 28%),
                linear-gradient(to right, rgba(0,0,0,0.04) 0%, transparent 3%, transparent 97%, rgba(0,0,0,0.04) 100%);
            padding: 42px 48px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.85);
            border: 1px solid #3a352f;
            position: relative;
        }

        /* MODO DE VISUALIZAÇÃO DO JOGADOR & MODO EXPORTAÇÃO PDF */
        body.modo-jogador .gm-only,
        body.exporting-pdf .gm-only {
            display: none !important;
        }

        body.modo-jogador .clue-row[data-secret="true"],
        body.exporting-pdf .clue-row[data-secret="true"] {
            display: none !important;
        }

        body.modo-jogador [contenteditable="true"],
        body.exporting-pdf [contenteditable="true"] {
            outline: none !important;
            border-bottom-color: transparent !important;
            background: transparent !important;
            pointer-events: none !important;
        }

        body.modo-jogador .stamp-status,
        body.exporting-pdf .stamp-status {
            pointer-events: none !important;
        }

        /* Esconde selects e mostra badges estáticas de alto contraste na visão do jogador e no PDF */
        .static-player-badge {
            display: none;
        }

        body.modo-jogador .interactive-select,
        body.exporting-pdf .interactive-select {
            display: none !important;
        }

        body.modo-jogador .static-player-badge,
        body.exporting-pdf .static-player-badge {
            display: inline-block !important;
        }

        /* CABEÇALHO DO DOSSIÊ */
        .dossier-header {
            border-bottom: 4px double var(--op-ink);
            padding-bottom: 18px;
            margin-bottom: 22px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            position: relative;
        }

        .dossier-tag-top {
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 2px;
            color: var(--op-red);
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .dossier-title {
            font-family: 'Crimson Text', serif;
            font-size: 2.6rem;
            font-weight: 900;
            letter-spacing: 3px;
            margin: 0;
            line-height: 1;
            color: var(--op-ink);
            text-transform: uppercase;
        }

        .dossier-subtitle {
            font-family: 'Special Elite', monospace;
            font-size: 12px;
            color: var(--cor-muted);
            margin-top: 6px;
        }

        .header-right-box {
            text-align: right;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
        }

        .barcode {
            font-family: 'Libre Barcode 39 Text', cursive;
            font-size: 36px;
            color: var(--op-ink);
            line-height: 0.85;
        }

        /* CARIMBO DE STATUS */
        .stamp-status {
            border: 3px solid var(--op-red);
            color: var(--op-red);
            font-family: 'Special Elite', monospace;
            font-size: 13px;
            font-weight: 700;
            padding: 5px 12px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            transform: rotate(-3deg);
            cursor: pointer;
            user-select: none;
            background: rgba(158, 11, 15, 0.05);
            box-shadow: inset 0 0 0 1px rgba(158, 11, 15, 0.25);
            transition: 0.15s;
        }

        .stamp-status:hover {
            transform: rotate(0deg) scale(1.03);
        }

        .stamp-status[data-status="EM ANDAMENTO"] {
            border-color: var(--san-purple);
            color: var(--san-purple);
            background: rgba(43, 58, 74, 0.06);
        }

        .stamp-status[data-status="INTERROMPIDA / ARQUIVADA"] {
            border-color: var(--pe-orange);
            color: var(--pe-orange);
            background: rgba(102, 82, 53, 0.06);
        }

        .stamp-status[data-status="CASO EXPURGADO"] {
            border-color: var(--op-ink);
            color: var(--op-ink);
            background: rgba(0, 0, 0, 0.08);
        }

        /* AVISO INICIAL AO JOGADOR (BRIEFING) */
        .briefing-banner {
            background: var(--bg-card);
            border: 1px solid var(--border-strong);
            border-left: 5px solid var(--op-red);
            padding: 14px 18px;
            margin-bottom: 24px;
            position: relative;
        }

        .briefing-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            gap: 10px;
            flex-wrap: wrap;
        }

        .briefing-title {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--op-red);
        }

        .stamp-mini {
            font-family: 'Special Elite', monospace;
            font-size: 10px;
            font-weight: 700;
            color: var(--op-ink);
            border: 1.5px solid var(--op-ink);
            padding: 2px 7px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* CAIXA DE INSTRUÇÃO DO MESTRE (SOME NO PDF E NA VISÃO DO JOGADOR) */
        .gm-hint {
            background: var(--gm-bg);
            border: 1px dashed var(--gm-border);
            color: var(--gm-text);
            padding: 8px 12px;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            line-height: 1.45;
            margin-bottom: 12px;
            border-radius: 2px;
        }

        .gm-hint strong {
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* CAMPOS EDITÁVEIS */
        .editable-field {
            min-height: 22px;
            padding: 3px 6px;
            border-bottom: 1px dotted rgba(26, 26, 26, 0.35);
            transition: background 0.15s;
            word-break: break-word;
            line-height: 1.5;
        }

        .editable-field:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.45);
            border-bottom: 1px solid var(--op-red);
        }

        .editable-block {
            min-height: 60px;
            padding: 10px 12px;
            background: rgba(255, 255, 255, 0.28);
            border: 1px solid var(--border-ink);
            line-height: 1.6;
            font-family: 'Crimson Text', serif;
            font-size: 1.15rem;
            color: var(--op-ink);
            word-break: break-word;
        }

        .editable-block:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.55);
            border-color: var(--op-red);
        }

        /* TÍTULOS DE SEÇÃO */
        .section-block {
            margin-bottom: 28px;
            page-break-inside: avoid;
        }

        .section-bar {
            background: var(--op-ink);
            color: var(--bg-paper);
            padding: 8px 14px;
            border-left: 5px solid var(--op-red);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }

        .section-bar h2 {
            margin: 0;
            font-family: 'Courier Prime', monospace;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #f3efe6;
        }

        .section-bar span {
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #bfb8a8;
        }

        /* GRID DE IDENTIFICAÇÃO */
        .id-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr 0.8fr;
            gap: 12px;
            margin-bottom: 16px;
        }

        .id-box {
            background: var(--bg-card);
            border: 1px solid var(--border-ink);
            padding: 10px 12px;
        }

        .id-label {
            font-family: 'Inter', sans-serif;
            font-size: 9px;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--cor-muted);
            display: block;
            margin-bottom: 4px;
        }

        .id-value {
            font-family: 'Special Elite', monospace;
            font-size: 15px;
            font-weight: 700;
            color: var(--op-ink);
        }

        /* TABELA DE PERSONAS REGISTRADAS */
        .personas-box {
            background: var(--bg-card);
            border: 1px solid var(--border-ink);
            padding: 12px 14px;
        }

        .personas-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            border-bottom: 1px dashed var(--border-ink);
            padding-bottom: 6px;
        }

        .personas-title {
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--op-ink);
        }

        .personas-table {
            width: 100%;
            border-collapse: collapse;
        }

        .personas-table th {
            text-align: left;
            font-family: 'Inter', sans-serif;
            font-size: 9px;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--cor-muted);
            padding: 6px 8px;
            border-bottom: 1px solid var(--border-ink);
        }

        .personas-table td {
            padding: 6px 8px;
            border-bottom: 1px dotted var(--border-ink);
            font-size: 13px;
            vertical-align: middle;
        }

        .persona-name-cell {
            font-family: 'Crimson Text', serif;
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--op-ink);
        }

        .persona-player-cell {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 700;
            color: var(--san-purple);
        }

        .persona-status-select {
            font-family: 'Courier Prime', monospace;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 8px;
            background: var(--bg-paper);
            color: var(--op-ink);
            border: 1px solid var(--border-ink);
            cursor: pointer;
            text-transform: uppercase;
        }

        .persona-status-badge {
            font-family: 'Courier Prime', monospace;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 8px;
            border: 1px solid var(--op-ink);
            color: var(--op-ink);
            background: rgba(0,0,0,0.05);
            text-transform: uppercase;
        }

        /* TIMELINE DE ACONTECIMENTOS (SEÇÃO II) */
        .events-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .event-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: var(--bg-card);
            border: 1px solid var(--border-ink);
            border-left: 4px solid var(--op-ink);
            padding: 10px 12px;
        }

        .event-bullet {
            font-family: 'Special Elite', monospace;
            font-size: 13px;
            font-weight: 700;
            color: var(--op-red);
            padding-top: 3px;
            user-select: none;
        }

        .event-text {
            flex: 1;
            font-family: 'Courier Prime', monospace;
            font-size: 13.5px;
            color: var(--op-ink);
        }

        /* ECOS NO MUNDO (SEÇÃO III) */
        .echoes-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .echo-card {
            background: var(--bg-card);
            border: 1px solid var(--border-ink);
            border-top: 3px solid var(--op-ink);
            padding: 12px 14px;
        }

        .echo-card-title {
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--op-red);
            margin-bottom: 6px;
            display: block;
        }

        .echo-card-body {
            font-family: 'Courier Prime', monospace;
            font-size: 13px;
            color: var(--op-ink);
            min-height: 55px;
        }

        /* SEÇÃO IV: ANEXOS E RELATOS PESSOAIS (CORRIGIDO ALTO CONTRASTE!) */
        .attachments-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .attachment-card {
            background: var(--bg-card);
            border: 1px solid var(--border-strong);
            padding: 14px 16px;
            position: relative;
        }

        .attachment-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            border-bottom: 1px solid var(--border-ink);
            padding-bottom: 8px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .attachment-header-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex: 1;
            flex-wrap: wrap;
        }

        /* Select no modo Mestre e Badge no modo Jogador — COR ESCURA FORTE E LEGÍVEL */
        .attachment-type-select {
            background: #22201d;
            color: #f5f1e8;
            border: 1px solid var(--op-ink);
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.8px;
            padding: 5px 10px;
            text-transform: uppercase;
            cursor: pointer;
            border-radius: 2px;
        }

        .attachment-type-badge {
            background: #22201d !important;
            color: #f5f1e8 !important;
            border: 1px solid #1a1a1a !important;
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 0.8px;
            padding: 4px 10px;
            text-transform: uppercase;
            border-radius: 2px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .attachment-title {
            font-family: 'Courier Prime', monospace;
            font-size: 13px;
            font-weight: 700;
            color: var(--op-red);
            text-transform: uppercase;
            flex: 1;
            min-width: 180px;
        }

        .attachment-body {
            font-size: 14px;
            line-height: 1.6;
            color: var(--op-ink);
            padding: 10px 12px;
            background: rgba(0, 0, 0, 0.03);
            border-left: 3px solid var(--op-ink);
        }

        .attachment-card[data-type="diario"] .attachment-body {
            font-family: 'Crimson Text', serif;
            font-style: italic;
            font-size: 1.15rem;
            background: repeating-linear-gradient(transparent, transparent 25px, rgba(0,0,0,0.06) 26px);
            border-left: 3px solid var(--pe-orange);
        }

        .attachment-card[data-type="audio"] .attachment-body {
            font-family: 'Courier Prime', monospace;
            border-left: 3px solid var(--op-red);
        }

        .attachment-card[data-type="prontuario"] .attachment-body {
            font-family: 'Inter', sans-serif;
            font-size: 12.5px;
            border-left: 3px solid var(--san-purple);
        }

        /* SEÇÃO V: MATRIZ DE PISTAS E CONHECIMENTO */
        .clues-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--bg-card);
            border: 1px solid var(--border-strong);
        }

        .clues-table th {
            background: var(--op-ink);
            color: #f3efe6;
            font-family: 'Courier Prime', monospace;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            padding: 10px 10px;
            border: 1px solid #333;
            text-align: left;
        }

        .clues-table td {
            padding: 10px;
            border: 1px solid var(--border-ink);
            vertical-align: top;
            font-size: 13px;
            color: var(--op-ink);
        }

        .clue-row[data-secret="true"] {
            background: rgba(158, 11, 15, 0.08);
        }

        .access-select {
            width: 100%;
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 800;
            padding: 5px 6px;
            background: var(--bg-paper);
            color: var(--op-ink);
            border: 1px solid var(--border-strong);
            text-transform: uppercase;
            cursor: pointer;
        }

        .access-badge {
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 800;
            padding: 4px 8px;
            border: 1px solid var(--op-ink);
            background: rgba(0,0,0,0.06);
            color: var(--op-ink);
            text-transform: uppercase;
        }

        /* SEÇÃO VI: EXCLUSIVA DO MESTRE */
        .gm-secret-section {
            border: 2px dashed var(--op-red);
            background: rgba(158, 11, 15, 0.04);
            padding: 16px;
            margin-top: 28px;
        }

        .gm-secret-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px dashed var(--op-red);
            padding-bottom: 8px;
            margin-bottom: 12px;
        }

        .gm-secret-header h3 {
            margin: 0;
            font-family: 'Courier Prime', monospace;
            font-size: 14px;
            font-weight: 700;
            color: var(--op-red);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* BOTÕES DE ADICIONAR / REMOVER ITEM (SÓ MESTRE) */
        .btn-add-item {
            background: rgba(0, 0, 0, 0.05);
            color: var(--op-ink);
            border: 1px dashed var(--op-ink);
            padding: 7px 14px;
            font-family: 'Courier Prime', monospace;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 10px;
            transition: 0.2s;
        }

        .btn-add-item:hover {
            background: var(--op-ink);
            color: var(--bg-paper);
        }

        .btn-del-row {
            background: transparent;
            border: 1px solid transparent;
            color: var(--op-red);
            font-family: 'Inter', sans-serif;
            font-size: 12px;
            font-weight: 900;
            cursor: pointer;
            padding: 2px 6px;
            opacity: 0.65;
        }

        .btn-del-row:hover {
            opacity: 1;
            border-color: var(--op-red);
