            const tr = document.createElement('tr');
            const pista = dados.pista || 'Símbolo / Documento';
            const onde = dados.onde || 'Capela / Arquivo Municipal';
            const sabe = dados.sabe || 'Marca associada aos desaparecimentos da década de 70.';
            const quem = dados.quem || 'Apenas investigadores e ex-funcionários';
            const acesso = dados.acesso || 'publico';
            const editAttr = document.body.classList.contains('modo-jogador') ? 'false' : 'true';

            tr.className = 'clue-row';
            tr.setAttribute('data-secret', acesso === 'mestre' ? 'true' : 'false');

            tr.innerHTML = `
                <td><div class="editable-field" contenteditable="${editAttr}" oninput="agendarSalvamento()" style="font-weight:700;">${pista}</div></td>
                <td><div class="editable-field" contenteditable="${editAttr}" oninput="agendarSalvamento()">${onde}</div></td>
                <td><div class="editable-field" contenteditable="${editAttr}" oninput="agendarSalvamento()">${sabe}</div></td>
                <td><div class="editable-field" contenteditable="${editAttr}" oninput="agendarSalvamento()">${quem}</div></td>
                <td>
                    <select class="access-select interactive-select" onchange="mudarAcessoPista(this)">
                        ${Object.entries(ACESSO_LABELS).map(([k, label]) => `<option value="${k}" ${k === acesso ? 'selected' : ''}>${label}</option>`).join('')}
                    </select>
                    <span class="access-badge static-player-badge">${ACESSO_LABELS[acesso] || ACESSO_LABELS.publico}</span>
                </td>
                <td class="gm-only" style="text-align:center;">
                    <button class="btn-del-row" onclick="this.closest('tr').remove(); agendarSalvamento();" title="Remover Pista">✕</button>
                </td>
            `;
            tbody.appendChild(tr);
            agendarSalvamento();
        }

        function mudarAcessoPista(selectEl) {
            const tr = selectEl.closest('tr');
            const val = selectEl.value;
            tr.setAttribute('data-secret', val === 'mestre' ? 'true' : 'false');
            const badge = tr.querySelector('.access-badge');
            if (badge) badge.innerText = ACESSO_LABELS[val] || val;
            agendarSalvamento();
        }

        // --- SEÇÃO VI: PONTAS SOLTAS DO MESTRE ---
        function adicionarPontaSolta(texto = 'O que aconteceu com o segundo artefato levado antes da chegada do grupo?') {
            const lista = document.getElementById('lista-pontas-soltas');
            const item = document.createElement('div');
            item.className = 'event-item';
            const editAttr = document.body.classList.contains('modo-jogador') ? 'false' : 'true';
            item.innerHTML = `
                <span class="event-bullet">?</span>
                <div class="event-text editable-field" contenteditable="${editAttr}" oninput="agendarSalvamento()">${texto}</div>
                <button class="btn-del-row gm-only" onclick="this.parentElement.remove(); agendarSalvamento();" title="Remover">✕</button>
            `;
            lista.appendChild(item);
            agendarSalvamento();
        }

        // --- COLETAR E SALVAR ESTADO DO DOSSIÊ ---
        function coletarDadosDossie() {
            const personas = [];
            document.querySelectorAll('#tbody-personas tr').forEach(tr => {
                const cells = tr.querySelectorAll('.editable-field');
                const sel = tr.querySelector('.persona-status-select');
                if (cells.length >= 2) {
                    personas.push({
                        nome: cells[0].innerText.trim(),
                        jogador: cells[1].innerText.trim(),
                        status: sel ? sel.value : 'ATIVO / SOBREVIVENTE'
                    });
                }
            });

            const acontecimentos = [];
            document.querySelectorAll('#lista-acontecimentos .event-text').forEach(el => {
                acontecimentos.push(el.innerText.trim());
            });

            const anexos = [];
            document.querySelectorAll('#lista-anexos .attachment-card').forEach(card => {
                const tipo = card.getAttribute('data-type') || 'diario';
                const titulo = card.querySelector('.attachment-title')?.innerText.replace(/^—\s*/, '').trim() || '';
                const conteudo = card.querySelector('.attachment-body')?.innerText.trim() || '';
                anexos.push({ tipo, titulo, conteudo });
            });

            const pistas = [];
            document.querySelectorAll('#tbody-pistas tr').forEach(tr => {
                const fields = tr.querySelectorAll('.editable-field');
                const sel = tr.querySelector('.access-select');
                if (fields.length >= 4) {
                    pistas.push({
                        pista: fields[0].innerText.trim(),
                        onde: fields[1].innerText.trim(),
                        sabe: fields[2].innerText.trim(),
                        quem: fields[3].innerText.trim(),
                        acesso: sel ? sel.value : 'publico'
                    });
                }
            });

            const pontasSoltas = [];
            document.querySelectorAll('#lista-pontas-soltas .event-text').forEach(el => {
                pontasSoltas.push(el.innerText.trim());
            });

            return {
                statusCampanha: document.getElementById('stamp-status').getAttribute('data-status') || 'CONCLUÍDA',
                briefing: document.getElementById('campo-briefing').innerText,
                nomeCampanha: document.getElementById('campo-nome-campanha').innerText,
                periodoLocal: document.getElementById('campo-periodo-local').innerText,
                codigoNucleo: document.getElementById('campo-codigo-nucleo').innerText,
                personas,
                abertura: document.getElementById('campo-abertura').innerText,
                acontecimentos,
                ecos: {
                    locais: document.getElementById('eco-locais').innerText,
                    organizacoes: document.getElementById('eco-organizacoes').innerText,
                    mudancas: document.getElementById('eco-mudancas').innerText,
                    objetos: document.getElementById('eco-objetos').innerText
                },
                anexos,
                pistas,
                segredosMestre: document.getElementById('campo-segredos-mestre').innerText,
                pontasSoltas,
                updatedAt: new Date().toISOString()
            };
        }

        function aplicarDadosDossie(d) {
            if (!d) return;
            const stamp = document.getElementById('stamp-status');
            if (d.statusCampanha) {
                stamp.setAttribute('data-status', d.statusCampanha);
                stamp.innerText = d.statusCampanha;
            }
            if (d.briefing !== undefined) document.getElementById('campo-briefing').innerText = d.briefing;
            if (d.nomeCampanha !== undefined) document.getElementById('campo-nome-campanha').innerText = d.nomeCampanha;
            if (d.periodoLocal !== undefined) document.getElementById('campo-periodo-local').innerText = d.periodoLocal;
            if (d.codigoNucleo !== undefined) document.getElementById('campo-codigo-nucleo').innerText = d.codigoNucleo;
            if (d.abertura !== undefined) document.getElementById('campo-abertura').innerText = d.abertura;

            if (d.ecos) {
                if (d.ecos.locais !== undefined) document.getElementById('eco-locais').innerText = d.ecos.locais;
                if (d.ecos.organizacoes !== undefined) document.getElementById('eco-organizacoes').innerText = d.ecos.organizacoes;
                if (d.ecos.mudancas !== undefined) document.getElementById('eco-mudancas').innerText = d.ecos.mudancas;
                if (d.ecos.objetos !== undefined) document.getElementById('eco-objetos').innerText = d.ecos.objetos;
            }

            if (d.segredosMestre !== undefined) document.getElementById('campo-segredos-mestre').innerText = d.segredosMestre;

            if (Array.isArray(d.personas)) {
                document.getElementById('tbody-personas').innerHTML = '';
                d.personas.forEach(p => adicionarLinhaPersona(p));
            }
            if (Array.isArray(d.acontecimentos)) {
                document.getElementById('lista-acontecimentos').innerHTML = '';
                d.acontecimentos.forEach(a => adicionarAcontecimento(a));
            }
            if (Array.isArray(d.anexos)) {
                document.getElementById('lista-anexos').innerHTML = '';
                d.anexos.forEach(ax => adicionarAnexo(ax.tipo, ax.titulo, ax.conteudo));
            }
            if (Array.isArray(d.pistas)) {
                document.getElementById('tbody-pistas').innerHTML = '';
                d.pistas.forEach(pi => adicionarPista(pi));
            }
            if (Array.isArray(d.pontasSoltas)) {
                document.getElementById('lista-pontas-soltas').innerHTML = '';
                d.pontasSoltas.forEach(ps => adicionarPontaSolta(ps));
            }
        }

        function agendarSalvamento() {
            const badge = document.getElementById('sync-status');
            if (badge) badge.innerText = '⏳ SALVANDO...';
            clearTimeout(saveTimer);
            saveTimer = setTimeout(salvarDossie, 600);
        }

        async function salvarDossie() {
            const dados = coletarDadosDossie();
            localStorage.setItem(STORAGE_KEY, JSON.stringify(dados));
            const badge = document.getElementById('sync-status');

            if (campDocId) {
                try {
                    await db.collection('campanhas').doc(campDocId).set({ dossieContinuidade: dados }, { merge: true });
                    if (badge) badge.innerText = '☁️ SINCRONIZADO NA CAMPANHA';
                    return;
                } catch (e) {
                    console.warn('Salvamento local ativo (Firebase indisponível):', e);
                }
            }
            if (badge) badge.innerText = '💾 SALVO NO NAVEGADOR';
        }

        async function importarPersonasDaCampanha() {
            if (!campCodigo) {
                alert('Nenhum código de campanha detectado na URL (abra o dossiê a partir de uma campanha no Hub).');
                return;
            }
            try {
                const snap = await db.collection('fichas').where('campanhaId', '==', campCodigo).get();
                if (snap.empty) {
                    alert('Nenhuma Persona vinculada a esta campanha foi encontrada no banco.');
                    return;
                }
                snap.forEach(doc => {
                    const f = doc.data();
                    if (!f.isNpcAmeaca) {
                        adicionarLinhaPersona({
                            nome: f.nome || 'Persona',
                            jogador: f.nomeJogador || 'Jogador',
                            status: 'ATIVO / SOBREVIVENTE'
                        });
                    }
                });
                agendarSalvamento();
            } catch (e) {
                alert('Erro ao buscar Personas da campanha.');
            }
        }

        // --- EXPORTAÇÃO DIRETA DE PDF NÃO-EDITÁVEL (VISÃO DO JOGADOR) ---
        async function exportarDossiePDF() {
            const btn = document.getElementById('btn-exportar-pdf');
            const textoOriginal = btn.innerText;
            btn.innerText = '⏳ GERANDO PDF...';
            btn.disabled = true;

            const estavaModoMestre = !document.body.classList.contains('modo-jogador');
            document.body.classList.add('exporting-pdf');
            document.body.classList.add('modo-jogador');

            const nomeCamp = (document.getElementById('campo-nome-campanha').innerText || 'campanha')
                .trim()
                .toLowerCase()
                .replace(/[^a-z0-9_-]+/gi, '_');

            const elemento = document.getElementById('dossier-page');

            try {
                if (typeof html2pdf !== 'undefined') {
                    const opt = {
                        margin: [8, 8, 8, 8],
                        filename: `dossie_${nomeCamp}.pdf`,
                        image: { type: 'jpeg', quality: 0.98 },
                        html2canvas: {
                            scale: 2,
                            useCORS: true,
                            backgroundColor: '#dcd7cb',
                            scrollY: 0
                        },
                        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                        pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
                    };
                    await html2pdf().set(opt).from(elemento).save();
                } else {
                    window.print();
                }
            } catch (err) {
                console.error('Erro no html2pdf, acionando impressão nativa:', err);
                window.print();
            } finally {
                document.body.classList.remove('exporting-pdf');
                if (estavaModoMestre) {
                    document.body.classList.remove('modo-jogador');
                }
                btn.innerText = textoOriginal;
                btn.disabled = false;
            }
        }

        // --- INICIALIZAÇÃO ---
        async function inicializarDossie() {
            if (campNomeParam) {
                document.getElementById('campo-nome-campanha').innerText = campNomeParam;
            }
            if (campCodigo) {
                document.getElementById('campo-codigo-nucleo').innerText = 'CÓDIGO: ' + campCodigo;
                document.getElementById('barcode-codigo').innerText = '*' + campCodigo + '*';
            }

            let carregado = false;

            // Tenta carregar do Firebase se houver id da campanha
            if (campDocId) {
                try {
                    const doc = await db.collection('campanhas').doc(campDocId).get();
                    if (doc.exists) {
                        const cData = doc.data();
                        if (cData.nome && !campNomeParam) {
                            document.getElementById('campo-nome-campanha').innerText = cData.nome;
                        }
                        if (cData.codigo) {
                            document.getElementById('campo-codigo-nucleo').innerText = 'CÓDIGO: ' + cData.codigo;
                            document.getElementById('barcode-codigo').innerText = '*' + cData.codigo + '*';
                        }
                        if (cData.dossieContinuidade) {
                            aplicarDadosDossie(cData.dossieContinuidade);
                            carregado = true;
                        }
                    }
                } catch (e) {
                    console.warn('Não foi possível ler o dossiê da nuvem, usando cache local:', e);
                }
            }

            // Fallback: carrega do localStorage
            if (!carregado) {
                const salvoLocal = localStorage.getItem(STORAGE_KEY);
                if (salvoLocal) {
                    try {
                        aplicarDadosDossie(JSON.parse(salvoLocal));
                        carregado = true;
                    } catch (e) {}
                }
            }

            // Se for um dossiê novo em branco, popula com linhas iniciais de exemplo
            if (!carregado) {
                adicionarLinhaPersona({ nome: 'Arthur Cervero', jogador: 'Pedro', status: 'ATIVO / SOBREVIVENTE' });
                adicionarLinhaPersona({ nome: 'Beatriz Vaz', jogador: 'Raphael', status: 'DESAPARECIDO (M.I.A.)' });

                adicionarAcontecimento('Descoberta dos registros médicos ocultos no subsolo da clínica.');
                adicionarAcontecimento('Confronto final na subestação e contenção parcial da anomalia.');

                adicionarAnexo('audio');
                adicionarAnexo('diario');

                adicionarPista({
                    pista: 'Fundação Aurora',
                    onde: 'Documentos da Diretoria',
                    sabe: 'Empresa de fachada que financia clínicas isoladas desde os anos 70.',
                    quem: 'Sobreviventes do caso',
                    acesso: 'publico'
                });
                adicionarPista({
                    pista: 'Símbolo da Espiral Dupla',
                    onde: 'Porta de ferro do subsolo',
                    sabe: 'Marca usada para canalizar medo e drenar energia elétrica local.',
                    quem: 'Ocultistas e investigadores',
                    acesso: 'resumo'
                });

                adicionarPontaSolta('Quem enviou o telegrama anônimo antes do incêndio na clínica?');
            }
        }

        window.addEventListener('DOMContentLoaded', inicializarDossie);
    </script>
